{
  "name": "proxy-keyhide",
  "version": "1.0.1",
  "description": "本地 AI 中转与 API 密钥保护工作台",
  "main": "./out/main/index.js",
  "author": "keyhide",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:ui": "vite --config vite.preview.config.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --composite false --incremental false && tsc -p tsconfig.web.json --noEmit --composite false --incremental false",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "test:backend": "node --test electron/main/__tests__/backend.test.cjs",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.7",
    "lucide-react": "^0.427.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.19",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.40",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.keyhide.app",
    "productName": "Keyhide",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Keyhide",
      "artifactName": "Keyhide-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Keyhide-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/icon.png"
    }
  }
}
